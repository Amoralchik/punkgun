{
  "name": "punkgun",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "tsc --noEmit && vitest run && vite build && node scripts/check-budget.mjs",
    "package": "npm run build && node scripts/check-budget.mjs && node scripts/package.mjs",
    "test:gym": "vitest run src/game/combat-gym.test.ts",
    "smoke:edge": "node scripts/smoke.mjs --browser=edge",
    "test:balance": "vitest run src/game/balance-matrix.test.ts --reporter=verbose",
    "smoke:firefox": "node scripts/smoke-playwright.mjs --browser=firefox",
    "smoke:webkit": "node scripts/smoke-playwright.mjs --browser=webkit"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
